# Copia este archivo a ".env" para desarrollo local y completa los valores reales.
# En Render, estas mismas variables se configuran en el panel del servicio (Environment).

# Cadena de conexión a Postgres. En Render usa la "Internal Database URL"
# de tu base de datos (no la externa) si el backend corre en el mismo proyecto.
DATABASE_URL=postgres://usuario:password@localhost:5432/celina

# Puerto local (Render inyecta el suyo propio automáticamente, no hace falta definirlo ahí).
PORT=3000

# Credencial única compartida por todos los agentes.
AUTH_USERNAME=celina
# Hash bcrypt de la contraseña real — generalo con: npm run hash-password -- "tu-contraseña"
AUTH_PASSWORD_HASH=

# Cadena larga y aleatoria para firmar los tokens de sesión.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Orígenes permitidos para CORS, separados por coma (sin barra final).
# Ej: http://127.0.0.1:5500,https://celina-cotizador.netlify.app
FRONTEND_ORIGIN=http://127.0.0.1:5500
